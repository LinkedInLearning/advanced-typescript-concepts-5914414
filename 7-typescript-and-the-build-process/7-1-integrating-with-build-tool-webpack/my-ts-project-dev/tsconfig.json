{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "target": "ES2020",
    "module": "ESNext",

    "strict": true,
    "allowJs": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
